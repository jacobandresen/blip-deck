{
  "name": "blip-deck",
  "version": "2.0.0",
  "description": "An arcade control deck web component: a joystick or d-pad and buttons for one or two players, for touch, mouse and pen.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./dist/blip-deck.js"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "node tools/build.mjs",
    "test": "node --import ./test/css.js --test --experimental-test-coverage --test-coverage-include=src/** --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 test/*.test.js",
    "test:browser": "npm run build && node --test 'test/browser/*.test.js'"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "21.0.4",
    "esbuild": "0.28.2",
    "happy-dom": "21.0.4",
    "playwright-core": "^1.63.0"
  }
}
